@import sys.libc;

fn max_usize(): usize {
  return (0 as usize) - 1;
}

fn byte_count<T>(count: usize): !usize {
  let size: usize = @size_of(T);
  if (size != 0 && count > max_usize() / size)
    return error.out_of_memory;

  let bytes: usize = count * size;
  if (bytes == 0)
    return 1;

  return bytes;
}

public {
  fn alloc<T>(count: usize): !T* {
    let bytes: usize = try byte_count<T>(count);
    let p: u8* = libc.malloc(bytes);
    if (p == 0 as u8*)
      return error.out_of_memory;

    return p as T*;
  }

  fn resize<T>(ptr: T*, count: usize): !T* {
    let bytes: usize = try byte_count<T>(count);
    let p: u8* = libc.realloc(ptr as u8*, bytes);
    if (p == 0 as u8*)
      return error.out_of_memory;

    return p as T*;
  }

  fn free<T>(ptr: T*): void {
    libc.free(ptr as u8*);
  }
}
