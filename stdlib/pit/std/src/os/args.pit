@import sys.libc;
@import core.slice.{ slice };

static saved_argc: usize = 0;
static saved_argv: u8** = 0 as u8**;

public {
  fn init(argc: i32, argv: u8**): void {
    if (argc < 0 || argv == 0 as u8**) {
      saved_argc = 0;
      return;
    }

    saved_argc = argc as usize;
    saved_argv = argv;
  }

  fn count(): usize {
    return saved_argc;
  }

  fn get(i: usize): ?slice<u8> {
    if (i >= saved_argc)
      return none;

    let p: u8* = *(saved_argv + i);
    return slice<u8>{ data: p, length: libc.strlen(p) };
  }

  fn program(): ?slice<u8> {
    return get(0);
  }
}
